# ReWear Application Environment Configuration

# Flask Secret Key
SECRET_KEY=rewear_sustainable_fashion_secret_key_2026

# Database Configuration
# Default: If MySQL is not configured or not running, the application automatically falls back to SQLite (rewear.db)
# For MySQL:
USE_MYSQL=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=rewear_db

# Or use a full connection URI (MySQL example: mysql+pymysql://root:@localhost:3306/rewear_db)
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/rewear_db

# Uploads Configuration
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload
